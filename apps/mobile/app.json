{
  "expo": {
    "name": "Internably",
    "slug": "internably-mobile",
    "scheme": "internably",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F2E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandeepkhatri.internably",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Internably uses your photo library when you choose a profile or post image."
      }
    },
    "android": {
      "package": "com.mandeepkhatri.internably",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F2E8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.89678193241-dto8ml58fb4e3fgjetoiql4pfmrur3oj"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://internablyapi-production.up.railway.app/api",
      "googleWebClientId": "89678193241-pptijq3n5iom0gh9a8t1h7a3vctoj9t1.apps.googleusercontent.com",
      "googleIosClientId": "89678193241-dto8ml58fb4e3fgjetoiql4pfmrur3oj.apps.googleusercontent.com",
      "googleAndroidClientId": "89678193241-57ep39u12q5k038mc5sqdcfgq7f9mttf.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "65bdc01e-20b3-4f90-81b4-0fe0dff430f4"
      }
    },
    "owner": "mandeepkhatri"
  }
}
