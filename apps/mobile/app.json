{
  "expo": {
    "name": "Internably",
    "slug": "internably-mobile",
    "scheme": "internably",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F2E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandeepkhatri.internably",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Internably uses your photo library when you choose a profile or post image."
      }
    },
    "android": {
      "package": "com.mandeepkhatri.internably",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F2E8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000/api"
    }
  }
}
